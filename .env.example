# Modo de execução do JiraClient.
# - true  → usa JiraMockClient (estado persistido em ./data/mock_jira.json). Não precisa de credenciais.
# - false → usa JiraRestClient real (Atlassian Cloud). Requer JIRA_BASE_URL/JIRA_EMAIL/JIRA_API_TOKEN.
JIRA_MOCK=true

# Apenas necessários quando JIRA_MOCK=false
JIRA_BASE_URL=https://yourco.atlassian.net
JIRA_EMAIL=you@yourco.com
JIRA_API_TOKEN=changeme

# Project key usada pelo bootstrap (3-10 letras maiúsculas)
JIRA_PROJECT_KEY=SSD
JIRA_PROJECT_NAME=Squad Sense Demo

# App
LOG_LEVEL=INFO
ENVIRONMENT=dev

# Database (etapa 2). Aponta para o postgres do docker-compose.
DATABASE_URL=postgresql+asyncpg://squad:squad@localhost:5434/squad_sense
REDIS_URL=redis://localhost:6379/0

# Embeddings (etapa 2). Sem chave → NullEmbeddingClient (zeros, só p/ pipeline rodar).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LLM (etapa 3b). Provider auto-detectado pela presença de chave:
#   ANTHROPIC_API_KEY definido → claude-sonnet-4-6 (default preferido)
#   só OPENAI_API_KEY definido → gpt-4.1-mini
# Para forçar manualmente, defina LLM_PROVIDER=anthropic|openai
ANTHROPIC_API_KEY=
LLM_PROVIDER=
LLM_MODEL_ANTHROPIC=claude-sonnet-4-6
LLM_MODEL_OPENAI=gpt-4o-mini
